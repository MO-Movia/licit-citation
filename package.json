{
  "name": "@modusoperandi/licit-citation",
  "version": "1.0.0",
  "subversion": "1",
  "type": "module",
  "description": "Citation plugin built with ProseMirror",
  "main": "index.js",
  "types": "index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MO-Movia/licit-citation"
  },
  "scripts": {
    "build": "tsc --build && copyfiles --up 1 \"src/**/*.css\" dist  && copyfiles package.json dist",
    "clean": "rm -rf dist/ && rm -f mo-licit-citation-*.*.*.tgz",
    "lint:ts": "eslint src --ext .ts,.tsx --fix",
    "lint": "npm run lint:ts",
    "postbuild": "cd ./dist/ && yalc push",
    "test:unit": "jest --coverage",
    "test:coverage": "jest --coverage",
    "test": "jest --coverage",
    "debug": "node --debug-brk --inspect ./node_modules/.bin/jest -i",
    "ci:bom": "npx cyclonedx-npm --ignore-npm-errors --short-PURLs --output-format XML --output-file dist/bom.xml",
    "ci:build": "tsc -b tsconfig.prod.json --clean && tsc -b tsconfig.prod.json && copyfiles --up 1 \"src/**/*.css\" dist  && copyfiles package.json README.md LICENSE dist",
    "verify": "npm run lint -- --fix && npm run ci:build && npm run test:coverage && echo 'All Tests Passed!'"
  },
  "peerDependencies": {
    "@modusoperandi/licit-ui-commands": "^1.0.0",
    "@modusoperandi/licit-doc-attrs-step": "^1.0.0",
    "prosemirror-model": "^1.0.0",
    "prosemirror-state": "^1.0.0",
    "prosemirror-transform": "^1.0.0",
    "prosemirror-view": "^1.0.0",
    "prosemirror-utils": "^1.2.2",
    "react": "^18.0.0"
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "color": "^5.0.2",
    "smooth-scroll-into-view-if-needed": "^1.1.32"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@modusoperandi/eslint-config": "^3.0.0",
    "copyfiles": "^2.4.1",
    "eslint": "^10.0.0",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-junit": "^16.0.0",
    "jest-prosemirror": "^3.0.1",
    "jest-sonar-reporter": "^2.0.0",
    "prosemirror-test-builder": "^1.1.1",
    "lint-staged": "^16.2.3",
    "prettier": "^3.2.5",
    "ts-jest": "^29.0.3",
    "ts-node": "^10.4.0",
    "typescript": "^5.9.3"
  },
  "importSort": {
    ".js": {
      "parser": "babylon",
      "style": "module-grouping"
    }
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.css": [
      "stylelint --fix"
    ],
    "!(*test|*.setup).ts": [
      "eslint --fix"
    ],
    "*.json": [
      "prettier --write"
    ]
  }
}